{
  "defaultProvider": "openai",
  "defaultModel": "gpt-5.5",
  "defaultThinkingLevel": "high",
  "trustPolicy": {
    "trustedUsers": [],
    "semiTrustedRoles": ["admin", "maintain", "write"],
    "untrustedBehavior": "read-only-response"
  },
  "limits": {
    "workflowTimeoutMinutes": 30
  },
  "compaction": {
    "enabled": true,
    "reserveTokens": 16384,
    "keepRecentTokens": 32000
  }
}
