{
  "defaultProvider": "openai",
  "defaultModel": "gpt-5.4",
  "defaultThinkingLevel": "high",
  "trustPolicy": {
    "trustedUsers": [],
    "semiTrustedRoles": ["write"],
    "untrustedBehavior": "read-only-response"
  },
  "limits": {
    "maxTokensPerRun": 10000000,
    "maxToolCallsPerRun": 1000,
    "workflowTimeoutMinutes": 120
  }
}
